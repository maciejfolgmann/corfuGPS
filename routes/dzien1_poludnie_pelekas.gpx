<gpx version="1.1" creator="corfu-scooter-gpx+valhalla" xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd"><metadata><name>Dzien 1 - Poludniowe Korfu + Pelekas</name><desc>trasa po drogach (BRouter 'safety') | realnie ~51 km | ~1 h 27 min jazdy | 11 waypointow</desc><time>2026-08-18T00:00:00Z</time></metadata><wpt lat="39.544017" lon="19.913324"><name>01 Benitses (start)</name><desc>baza wypadowa - start i meta kazdej trasy; promenada i tawerny</desc></wpt><wpt lat="39.562782" lon="19.904152"><name>02 Achilleion</name><desc>palac cesarzowej Sisi (Elzbiety Bawarskiej) z ogrodami i widokiem na morze; platny wstep, parking u gory</desc></wpt><wpt lat="39.554653" lon="19.886806"><name>03 Agioi Deka</name><desc>wioska w interiorze, widoki na okolice; szybki postoj na kawe</desc></wpt><wpt lat="39.567032" lon="19.847642"><name>04 Sinarades</name><desc>autentyczna wioska w interiorze; z drogi widok na zachodnie wybrzeze</desc></wpt><wpt lat="39.592494" lon="19.822496"><name>05 Pelekas</name><desc>wioska na wzgorzu z krzywymi uliczkami i widokiem; punkt na kawe</desc></wpt><wpt lat="39.602800" lon="19.818100"><name>06 Kaiser's Throne</name><desc>najslynniejszy punkt widokowy Korfu (tron cesarza Wilhelma II) - panorama na Glyfade; krotkie podejscie od parkingu</desc></wpt><wpt lat="39.591339" lon="19.808875"><name>07 Glyfada</name><desc>szeroka piaszczysta plaza na zachodzie, schody z klifu; kapiel i bar na plazy</desc></wpt><wpt lat="39.546372" lon="19.853571"><name>08 Agios Gordios</name><desc>dluga plaza z monolitem skalnym; kapiel, tawerny, parking przy drodze</desc></wpt><wpt lat="39.533899" lon="19.848167"><name>09 Pentati</name><desc>wioska na wybrzezu z widokiem na skale Ortholithi w morzu; powrot wzdluz wybrzeza</desc></wpt><wpt lat="39.493969" lon="19.872864"><name>10 Agios Mattheos</name><desc>gorska wioska z klasztorem (Moni Agiou Matthaiou) i panorama na poludnie Korfu; krotkie podejscie od wioski</desc></wpt><wpt lat="39.544017" lon="19.913324"><name>11 Benitses (koniec)</name><desc>baza wypadowa - start i meta kazdej trasy; promenada i tawerny</desc></wpt><rte><name>Dzien 1 - Poludniowe Korfu + Pelekas</name><rtept lat="39.544017" lon="19.913324"><name>01 Benitses (start)</name></rtept><rtept lat="39.562782" lon="19.904152"><name>02 Achilleion</name></rtept><rtept lat="39.554653" lon="19.886806"><name>03 Agioi Deka</name></rtept><rtept lat="39.567032" lon="19.847642"><name>04 Sinarades</name></rtept><rtept lat="39.592494" lon="19.822496"><name>05 Pelekas</name></rtept><rtept lat="39.602800" lon="19.818100"><name>06 Kaiser's Throne</name></rtept><rtept lat="39.591339" lon="19.808875"><name>07 Glyfada</name></rtept><rtept lat="39.546372" lon="19.853571"><name>08 Agios Gordios</name></rtept><rtept lat="39.533899" lon="19.848167"><name>09 Pentati</name></rtept><rtept lat="39.493969" lon="19.872864"><name>10 Agios Mattheos</name></rtept><rtept lat="39.544017" lon="19.913324"><name>11 Benitses (koniec)</name></rtept></rte><trk><name>Dzien 1 - Poludniowe Korfu + Pelekas (po drogach)</name><trkseg><trkpt lat="39.544132" lon="19.913350" /><trkpt lat="39.544176" lon="19.913034" /><trkpt lat="39.544114" lon="19.912944" /><trkpt lat="39.544074" lon="19.912813" /><trkpt lat="39.544452" lon="19.912834" /><trkpt lat="39.544453" lon="19.912770" /><trkpt lat="39.544452" lon="19.912486" /><trkpt lat="39.544443" lon="19.912325" /><trkpt lat="39.544473" lon="19.912191" /><trkpt lat="39.544480" lon="19.911844" /><trkpt lat="39.544686" lon="19.911453" /><trkpt lat="39.544835" lon="19.911538" /><trkpt lat="39.544904" lon="19.911594" /><trkpt lat="39.544997" lon="19.911536" /><trkpt lat="39.545081" lon="19.911702" /><trkpt lat="39.545340" lon="19.911506" /><trkpt lat="39.545363" lon="19.911493" /><trkpt lat="39.545370" lon="19.911423" /><trkpt lat="39.545350" lon="19.911255" /><trkpt lat="39.545345" lon="