<?xml version='1.0' encoding='utf-8'?>
<gpx version="1.1" creator="corfu-scooter-gpx+valhalla" xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd"><metadata><name>Dzien 2 - Wielkie zachodnie Korfu</name><desc>trasa po drogach (BRouter 'safety') | realnie ~88 km | ~2 h 31 min jazdy | 16 waypointow</desc><time>2026-08-18T00:00:00Z</time></metadata><wpt lat="39.544017" lon="19.913324"><name>01 Benitses (start)</name><desc>baza wypadowa - start i meta kazdej trasy; promenada i tawerny</desc></wpt><wpt lat="39.579800" lon="19.912800"><name>02 Perama</name><desc>nadmorska wioska z widokiem na Wyspe Myszy (Pontikonisi) i klasztor Vlacherna; postoj na start dnia</desc></wpt><wpt lat="39.632061" lon="19.762462"><name>03 Giannades</name><desc>wioska na wzgorzu - punkt widokowy na doline Ropy, a na wschodzie Pantokrator i Corfu Town; kawe na placu z widokiem</desc></wpt><wpt lat="39.688996" lon="19.739982"><name>04 Doukades</name><desc>wioska w interiorze na polnocy - brama do grzbietu Lakones</desc></wpt><wpt lat="39.681457" lon="19.708667"><name>05 Lakones</name><desc>wioska na grzbiecie z balustrada widokowa nad zatoka Paleokastritsa - klasyczna fotka</desc></wpt><wpt lat="39.679450" lon="19.699820"><name>06 Bella Vista</name><desc>punkt widokowy na zatoce Paleokastritsa przy restauracji o tej samej nazwie</desc></wpt><wpt lat="39.678268" lon="19.686576"><name>07 Angelokastro</name><desc>zamek bizantyjski z XIII w. na skalnym szczycie; wejscie pieszo ~20 min, widok na oba wybrzeza</desc></wpt><wpt lat="39.689622" lon="19.688661"><name>08 Makrades</name><desc>wioska na grzbiecie z widokami na Paleokastritse; tawerny ze stolikami nad urwiskiem</desc></wpt><wpt lat="39.675772" lon="19.711903"><name>09 Paleokastritsa</name><desc>klasztor nad zatoka + turkusowe zatoczki; kapiel albo lunch w tawernie</desc></wpt><wpt lat="39.670524" lon="19.727886"><name>10 Rovinia</name><desc>kamienista, spokojna plaza pod Liapades; skuter zostaje u gory, zejscie pieszo</desc></wpt><wpt lat="39.669142" lon="19.740371"><name>11 Liapades</name><desc>wioska; stamtad pieszo na plaza Liapades (20 min)</desc></wpt><wpt lat="39.591339" lon="19.808875"><name>12 Glyfada</name><desc>szeroka piaszczysta plaza na zachodzie, schody z klifu; kapiel i bar na plazy</desc></wpt><wpt lat="39.602800" lon="19.818100"><name>13 Kaiser's Throne</name><desc>najslynniejszy punkt widokowy Korfu (tron cesarza Wilhelma II) - panorama na Glyfade; krotkie podejscie od parkingu</desc></wpt><wpt lat="39.592494" lon="19.822496"><name>14 Pelekas</name><desc>wioska na wzgorzu z krzywymi uliczkami i widokiem; punkt na kawe</desc></wpt><wpt lat="39.567032" lon="19.847642"><name>15 Sinarades</name><desc>autentyczna wioska w interiorze; z drogi widok na zachodnie wybrzeze</desc></wpt><wpt lat="39.544017" lon="19.913324"><name>16 Benitses (koniec)</name><desc>baza wypadowa - start i meta kazdej trasy; promenada i tawerny</desc></wpt><rte><name>Dzien 2 - Wielkie zachodnie Korfu</name><rtept lat="39.544017" lon="19.913324"><name>01 Benitses (start)</name></rtept><rtept lat="39.579800" lon="19.912800"><name>02 Perama</name></rtept><rtept lat="39.632061" lon="19.762462"><name>03 Giannades</name></rtept><rtept lat="39.688996" lon="19.739982"><name>04 Doukades</name></rtept><rtept lat="39.681457" lon="19.708667"><name>05 Lakones</name></rtept><rtept lat="39.679450" lon="19.699820"><name>06 Bella Vista</name></rtept><rtept lat="39.678268" lon="19.686576"><name>07 Angelokastro</name></rtept><rtept lat="39.689622" lon="19.688661"><name>08 Makrades</name></rtept><rtept lat="39.675772" lon="19.711903"><name>09 Paleokastritsa</name></rtept><rtept lat="39.670524" lon="19.727886"><name>10 Rovinia</name></rtept><rtept lat="39.669142" lon="19.740371"><name>11 Liapades</name></rtept><rtept lat="39.591339" lon="19.808875"><name>12 Glyfada</name></rtept><rtept lat="39.602800" lon="19.818100"><name>13 Kaiser's Throne</name></rtept><rtept lat="39.592494" lon="19.822496"><name>14 Pelekas</name></rtept><rtept lat="39.567032" lon="19.847642"><name>15 Sinarades</name></rtept><rtept lat="39.544017" lon="19.913324"><name>16 Benitses (koniec)</name></rtept></rte><trk><name>Dzien 2 - Wielkie zachodnie Korfu (po drogach)</name><trkseg><trkpt lat="39.544132" lon="19.913350" /><trkpt lat="39.544130" lon="19.913369" /><trkpt lat="39.544166" lon="19.913834" /><trkpt lat="39.544145" lon="19.913864" /><trkpt lat="39.543869" lon="19.913942" /><trkpt lat="39.543819" lon="19.913988" /><trkpt lat="39.543774" lon="19.914072" /><trkpt lat="39.543751" lon="19.914176" /><trkpt lat="39.543753" lon="19.914371" /><trkpt lat="39.544354" lon="19.914449" /><trkpt lat="39.544488" lon="19.914447" /><trkpt lat="39.544621" lon="19.914431" /><trkpt lat="39.544709" lon="19.914412" /><trkpt lat="39.544743" lon="19.914521" /><trkpt lat="39.544766" lon="19.914551" /><trkpt lat="39.544835" lon="19.914568" /><trkpt lat="39.544953" lon="19.914544" /><trkpt lat="39.545242" lon="19.914451" /><trkpt lat="39.545354" lon="19.914391" /><trkpt lat="39.545404" lon="19.914344" /><trkpt lat="39.545450" lon="19.914289" /><trkpt lat="39.545472" lon="19.914219" /><trkpt lat="39.545479" lon="19.914109" /><trkpt lat="39.545528" lon="19.914074" /><trkpt lat="39.545656" lon="19.913931" /><trkpt lat="39.546001" lon="19.913545" /><trkpt lat="39.546270" lon="19.913209" /><trkpt lat="39.546389" lon="19.913080" /><trkpt lat="39.546418" lon="19.913050" /><trkpt lat="39.546570" lon="19.912899" /><trkpt lat="39.546718" lon="19.912761" /><trkpt lat="39.546820" lon="19.912667" /><trkpt lat="39.546914" lon="19.912583" /><trkpt lat="39.547044" lon="19.912483" /><trkpt lat="39.547115" lon="19.912451" /><trkpt lat="39.547200" lon="19.912414" /><trkpt lat="39.547362" lon="19.912374" /><trkpt lat="39.547855" lon="19.912309" /><trkpt lat="39.547976" lon="19.912286" /><trkpt lat="39.548128" lon="19.912256" /><trkpt lat="39.548368" lon="19.912166" /><t