<gpx version="1.1" creator="corfu-scooter-gpx+valhalla" xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd"><metadata><name>Dzien 4 - Pantokrator</name><desc>trasa po drogach (BRouter 'safety') | realnie ~135 km | ~3 h 52 min jazdy | 12 waypointow</desc><time>2026-08-18T00:00:00Z</time></metadata><wpt lat="39.544017" lon="19.913324"><name>01 Benitses (start)</name><desc>baza wypadowa - start i meta kazdej trasy; promenada i tawerny</desc></wpt><wpt lat="39.718521" lon="19.869265"><name>02 Barbati</name><desc>plaza z kamykami, widok na wybrzeze Albanii; szybka kapiel</desc></wpt><wpt lat="39.726481" lon="19.900540"><name>03 Nissaki</name><desc>zatoczka z krystaliczna woda i kilkoma tawernami</desc></wpt><wpt lat="39.743951" lon="19.933211"><name>04 Kalami</name><desc>zatoka, dom Lawrence'a Durrella; kapiel i lunch nad woda</desc></wpt><wpt lat="39.789106" lon="19.922053"><name>05 Kassiopi</name><desc>nadmorska wioska z portem i ruinami zameczku; lunch albo kapiel</desc></wpt><wpt lat="39.786361" lon="19.878601"><name>06 Loutses</name><desc>wioska na grzbiecie z widokiem na wschodnie wybrzeze</desc></wpt><wpt lat="39.764553" lon="19.875472"><name>07 Old Perithia</name><desc>opuszczona wioska gorska (XV-XIX w.), kamienne domy i tawerny; z dala od tlumu</desc></wpt><wpt lat="39.748058" lon="19.872078"><name>08 Pantokrator</name><desc>najwyzszy szczyt Korfu (906 m), klasztor i panorama; wolno pod gore, przerwy na chlodzenie silnika</desc></wpt><wpt lat="39.720957" lon="19.841771"><name>09 Spartilas</name><desc>wioska z widokiem na wschodnie wybrzeze; punkt na przerwe</desc></wpt><wpt lat="39.706418" lon="19.794181"><name>10 Ano Korakiana</name><desc>wioska w dolinie Ropy z bizantyjskim mlynem oliwnym (muzeum); krotki postoj</desc></wpt><wpt lat="39.700211" lon="19.774740"><name>11 Skripero</name><desc>tradycyjna wioska z muzeum oliwek (tlocznia) i tawernami; postoj na kawe</desc></wpt><wpt lat="39.544017" lon="19.913324"><name>12 Benitses (koniec)</name><desc>baza wypadowa - start i meta kazdej trasy; promenada i tawerny</desc></wpt><rte><name>Dzien 4 - Pantokrator</name><rtept lat="39.544017" lon="19.913324"><name>01 Benitses (start)</name></rtept><rtept lat="39.718521" lon="19.869265"><name>02 Barbati</name></rtept><rtept lat="39.726481" lon="19.900540"><name>03 Nissaki</name></rtept><rtept lat="39.743951" lon="19.933211"><name>04 Kalami</name></rtept><rtept lat="39.789106" lon="19.922053"><name>05 Kassiopi</name></rtept><rtept lat="39.786361" lon="19.878601"><name>06 Loutses</name></rtept><rtept lat="39.764553" lon="19.875472"><name>07 Old Perithia</name></rtept><rtept lat="39.748058" lon="19.872078"><name>08 Pantokrator</name></rtept><rtept lat="39.720957" lon="19.841771"><name>09 Spartilas</name></rtept><rtept lat="39.706418" lon="19.794181"><name>10 Ano Korakiana</name></rtept><rtept lat="39.700211" lon="19.774740"><name>11 Skripero</name></rtept><rtept lat="39.544017" lon="19.913324"><name>12 Benitses (koniec)</name></rtept></rte><trk><name>Dzien 4 - Pantokrator (po drogach)</name><trkseg><trkpt lat="39.544132" lon="19.913350" /><trkpt lat="39.544130" lon="19.913369" /><trkpt lat="39.544166" lon="19.913834" /><trkpt lat="39.544145" lon="19.913864" /><trkpt lat="39.543869" lon="19.913942" /><trkpt lat="39.543819" lon="19.913988" /><trkpt lat="39.543774" lon="19.914072" /><trkpt lat="39.543751" lon="19.914176" /><trkpt lat="39.543753" lon="19.914371" /><trkpt lat="39.544354" lon="19.914449" /><trkpt lat="39.544488" lon="19.914447" /><trkpt lat="39.544621" lon="19.914431" /><trkpt lat="39.544709" lon="19.914412" /><trkpt lat="39.544743" lon="19.914521" /><trkpt lat="39.544766" lon="19.914551" /><trkpt lat="39.544835" lon="19.914568" /><trkpt lat="39.544953" lon="19.914544" /><trkpt lat="39.545242" lon="19.914451" /><trkpt lat="39.545354" lon="19.914391" /><trkpt lat="39.545404" lon="19.914