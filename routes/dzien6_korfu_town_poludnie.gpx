<gpx version="1.1" creator="corfu-scooter-gpx+valhalla" xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd"><metadata><name>Dzien 6 - Corfu Town + poludniowe Korfu</name><desc>trasa po drogach (BRouter 'safety') | realnie ~117 km | ~3 h 20 min jazdy | 14 waypointow</desc><time>2026-08-18T00:00:00Z</time></metadata><wpt lat="39.544017" lon="19.913324"><name>01 Benitses (start)</name><desc>baza wypadowa - start i meta kazdej trasy; promenada i tawerny</desc></wpt><wpt lat="39.599542" lon="19.921370"><name>02 Kanoni</name><desc>punkt widokowy na wyspe Vlacherna i Wyspe Myszy (Pontikonisi); klasyczna fotka</desc></wpt><wpt lat="39.624068" lon="19.921377"><name>03 Corfu Old Town</name><desc>starowka UNESCO - stary port, Spianada, fort; skuter zostaje na parkingu, zwiedzanie pieszo</desc></wpt><wpt lat="39.567032" lon="19.847642"><name>04 Sinarades</name><desc>autentyczna wioska w interiorze; z drogi widok na zachodnie wybrzeze</desc></wpt><wpt lat="39.447596" lon="19.886119"><name>05 Halikounas</name><desc>dluga dzika plaza na zachodzie przy jeziorze; wietrznie - kite i windsurfing</desc></wpt><wpt lat="39.445830" lon="19.910800"><name>06 Lake Korission</name><desc>laguna z ptakami, widok z drogi; spokojne miejsce na przerwe</desc></wpt><wpt lat="39.429308" lon="19.939326"><name>07 Issos</name><desc>plaza z wydmami przy jeziorze; dzika, malo ludzi</desc></wpt><wpt lat="39.422140" lon="19.964548"><name>08 Agios Georgios Notos</name><desc>dluga piaszczysta plaza na poludniu (zachodnia strona); spokojna kapiel</desc></wpt><wpt lat="39.422776" lon="20.062872"><name>09 Lefkimmi</name><desc>druga wioska Korfu, kanal z mostem i lokalne zycie; krotki spacer</desc></wpt><wpt lat="39.382975" lon="20.115048"><name>10 Kavos</name><desc>najbardziej na poludnie - plaza i deptak; kapiel albo szybki rzut oka</desc></wpt><wpt lat="39.365841" lon="20.101741"><name>11 Arkoudilas</name><desc>plaza na samym czubku wyspy (Cape Kavos), turkusowa woda; skuter do samej plazy</desc></wpt><wpt lat="39.459542" lon="19.977214"><name>12 Boukari</name><desc>rybacka wioska z tawernami rybnymi nad portem; lunch</desc></wpt><wpt lat="39.485759" lon="19.925582"><name>13 Moraitika</name><desc>wioska z plaza i tawernami przy drodze</desc></wpt><wpt lat="39.544017" lon="19.913324"><name>14 Benitses (koniec)</name><desc>baza wypadowa - start i meta kazdej trasy; promenada i tawerny</desc></wpt><rte><name>Dzien 6 - Corfu Town + poludniowe Korfu</name><rtept lat="39.544017" lon="19.913324"><name>01 Benitses (start)</name></rtept><rtept lat="39.599542" lon="19.921370"><name>02 Kanoni</name></rtept><rtept lat="39.624068" lon="19.921377"><name>03 Corfu Old Town</name></rtept><rtept lat="39.567032" lon="19.847642"><name>04 Sinarades</name></rtept><rtept lat="39.447596" lon="19.886119"><name>05 Halikounas</name></rtept><rtept lat="39.445830" lon="19.910800"><name>06 Lake Korission</name></rtept><rtept lat="39.429308" lon="19.939326"><name>07 Issos</name></rtept><rtept lat="39.422140" lon="19.964548"><name>08 Agios Georgios Notos</name></rtept><rtept lat="39.422776" lon="20.062872"><name>09 Lefkimmi</name></rtept><rtept lat="39.382975" lon="20.115048"><name>10 Kavos</name></rtept><rtept lat="39.365841" lon="20.101741"><name>11 Arkoudilas</name></rtept><rtept lat="39.459542" lon="19.977214"><name>12 Boukari</name></rtept><rtept lat="39.485759" lon="19.925582"><name>13 Moraitika</name></rtept><rtept lat="39.544017" lon="19.913324"><name>14 Benitses (koniec)</name></rtept></rte><trk><name>Dzien 6 - Corfu Town + poludniowe Korfu (po drogach)</name><trkseg><trkpt lat="39.544132" lon="19.913350" /><trkpt lat="39.544130" lon="19.913369" /><trkpt lat="39.544166" lon="19.913834" /><trkpt lat="39.544145" lon="19.913864" /><trkpt lat="39.543869" lon="19.913942" /><trkpt lat="39.543819" lon="19.913988" /><trkpt lat="39.543774" lon="19.914072" /><trkpt