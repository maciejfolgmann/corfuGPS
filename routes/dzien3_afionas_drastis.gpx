<gpx version="1.1" creator="corfu-scooter-gpx+valhalla" xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd"><metadata><name>Dzien 3 - Afionas + Porto Timoni + Cape Drastis</name><desc>trasa po drogach (BRouter 'safety') | realnie ~112 km | ~3 h 11 min jazdy | 11 waypointow</desc><time>2026-08-18T00:00:00Z</time></metadata><wpt lat="39.544017" lon="19.913324"><name>01 Benitses (start)</name><desc>baza wypadowa - start i meta kazdej trasy; promenada i tawerny</desc></wpt><wpt lat="39.710980" lon="19.745700"><name>02 Troumpeta</name><desc>wioska w interiorze polnocy - przejazd, ewentualnie krotki postoj</desc></wpt><wpt lat="39.717672" lon="19.678679"><name>03 Agios Georgios Pagon</name><desc>szeroka piaszczysta plaza na zachodzie polnocy; kapiel, lezaki, bary</desc></wpt><wpt lat="39.724388" lon="19.660518"><name>04 Afionas</name><desc>wioska na cyplu - punkt widokowy na Porto Timoni i Cape Drastis</desc></wpt><wpt lat="39.715093" lon="19.657751"><name>05 Porto Timoni</name><desc>podwojna zatoka, najpiekniejszy widok na zachodzie; skuter zostaje na gorze, zejscie ~15 min</desc></wpt><wpt lat="39.744237" lon="19.649756"><name>06 Arillas</name><desc>dluga piaszczysta plaza w zatoce; kapiel, snack bary</desc></wpt><wpt lat="39.787909" lon="19.672666"><name>07 Peroulades</name><desc>wioska na klifach nad Loggas; punkt na zachod slonca</desc></wpt><wpt lat="39.798630" lon="19.673811"><name>08 Cape Drastis</name><desc>biale klify na polnocnym cyplu, turkusowa woda; ostatni fragment szutrowy - jesli zle, zostaw skuter i podejdz</desc></wpt><wpt lat="39.787611" lon="19.666557"><name>09 Loggas</name><desc>plaza u stop klifow z widokiem na Cape Drastis; schody z parkingu</desc></wpt><wpt lat="39.792820" lon="19.701730"><name>10 Sidari</name><desc>Canal d'Amour - formacje skalne, kapiel w przesmyku; latem tlumno</desc></wpt><wpt lat="39.544017" lon="19.913324"><name>11 Benitses (koniec)</name><desc>baza wypadowa - start i meta kazdej trasy; promenada i tawerny</desc></wpt><rte><name>Dzien 3 - Afionas + Porto Timoni + Cape Drastis</name><rtept lat="39.544017" lon="19.913324"><name>01 Benitses (start)</name></rtept><rtept lat="39.710980" lon="19.745700"><name>02 Troumpeta</name></rtept><rtept lat="39.717672" lon="19.678679"><name>03 Agios Georgios Pagon</name></rtept><rtept lat="39.724388" lon="19.660518"><name>04 Afionas</name></rtept><rtept lat="39.715093" lon="19.657751"><name>05 Porto Timoni</name></rtept><rtept lat="39.744237" lon="19.649756"><name>06 Arillas</name></rtept><rtept lat="39.787909" lon="19.672666"><name>07 Peroulades</name></rtept><rtept lat="39.798630" lon="19.673811"><name>08 Cape Drastis</name></rtept><rtept lat="39.787611" lon="19.666557"><name>09 Loggas</name></rtept><rtept lat="39.792820" lon="19.701730"><name>10 Sidari</name></rtept><rtept lat="39.544017" lon="19.913324"><name>11 Benitses (koniec)</name></rtept></rte><trk><name>Dzien 3 - Afionas + Porto Timoni + Cape Drastis (po drogach)</name><trkseg><trkpt lat="39.544132" lon="19.913350" /><trkpt lat="39.544130" lon="19.913369" /><trkpt lat="39.544166" lon="19.913834" /><trkpt lat="39.544145" lon="19.913864" /><trkpt lat="39.543869" lon="19.913942" /><trkpt lat="39.543819" lon="19.913988" /><trkpt lat="39.543774" lon="19.914072" /><trkpt lat="39.543751" lon="19.914176" /><trkpt lat="39.543753" lon="19.914371" /><trkpt lat="39.544354" lon="19.914449" /><trkpt lat="39.544488" lon="19.914447" /><trkpt lat="39.544621" lon="19.914431" /><trkpt lat="39.544709" lon="19.914412" /><trkpt lat="39.544743" lon="19.914521" /><trkpt lat="39.544766" lon="19.914551" /><trkpt lat="39.544835" lon="19.914568" /><trkpt lat="39.544953" lon="19.914544" /><trkpt lat="39.545242" lon="19.914451" /><trkpt lat="39.545354" lon="19.914391" /><trkpt lat="39.545404" lon="19.914344" /><trkpt lat="39.545450" lon="19.914289" /><trkpt lat="39.545472" lon="19.9